# --- maintained fork additions (append-only) ---
# 只列上游段未覆盖的条目；重复项已移除，避免同一规则两处维护。

# Runtime artifacts that must never enter the public fork
# 锚定到仓库根：否则任意层级的 data/ 都会被静默忽略（例如将来 tests/**/data/）
/data/
*.db
*.sqlite
*.sqlite3
.env
.env.*
configs/session/

# Large binaries
*.mp4
*.mkv
*.avi
*.mov
*.zip
*.7z
*.rar
*.tar.gz
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.pdf

# Third-party plugin sources are private and must never be committed here
data/plugins/**
astrbot_plugin_astrbot_enhance_mode/
astrbot_plugin_content_safety_guard/

# Local scratch
optimization_backups/
maintained/.tmp/

# 上游的 `data` 规则未锚定，会匹配任意层级（含 tests/**/data/）。
# 显式放行本 fork 自有的测试数据目录，避免将来加固定数据时被静默忽略。
!tests/maintained/data/
!tests/maintained/data/**

# WorkBuddy local state (never published)
.workbuddy/

# Internal working documents: session handovers, pending-work lists, local ops logs,
# project maps and audits. They answer "where did we stop" / "why is this file like
# this" for the maintainer, not "how do I use this fork" for a reader. They also name
# the operator's own instance path, accounts and private plugins, so they stay on disk
# only. Everything that should be published lives under docs/.
.internal/

# Build and release artefacts (regenerated, never committed)
/dist/
/release-assets/
